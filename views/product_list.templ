package views

import (
"gl/models"
"strconv"
)

templ ProductList(products []models.Product) {
<div class="d-flex w-100 justify-content-center px-5 py-5">

    <div class="card shadow p-4 w-100 mt-5">
        <div class="card-header">
            <h5 class="card-title text-center">Product List</h5>
        </div>
        <table class="table w-100">
            <thead>
                <tr>
                    <th scope="col">Product Code</th>
                    <th scope="col">Product Description</th>
                    <th scope="col">Unit</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                for _, p := range products {
                <tr>
                    <th scope="row">{p.ProductCode}</th>
                    <td>{p.ProductDescription}</td>
                    if p.Unit != nil {
                    <td>{*p.Unit}</td>
                    } else {
                    <td>unit not set</td>
                    }
                    <td>
                        if p.Id != nil {
                        <a href={ "/inventory/product/" + strconv.FormatInt(int64(*p.Id), 10) }>
                            <i class="bi bi-pencil"></i>
                        </a>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}