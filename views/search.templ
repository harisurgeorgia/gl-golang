package views

templ Search(navData NavData){
<form class="d-flex mb-0" role="search" id="search-form" id="search-form" name="search-form" action={ *navData.Link }
    method="get">
    <input required class="form-control me-2" name="search" id="search" type="search" placeholder="Search"
        aria-label="Search" />
    <button class="btn btn-outline-success" type="submit">Search</button>
</form>
}