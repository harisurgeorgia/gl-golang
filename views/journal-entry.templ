package views

import (
"gl/models"
"strconv"
)

templ JournalEntryForm(header, msg string, journal models.Journal, accounts []models.Account, postStatus bool) {
<div class="container" if postStatus { inert }>
  <div class="d-flex justify-content-center">
    <h1 class="m-4 text-primary">{ header }</h1>
  </div>
  <!-- centered heading with background -->

  <form action="/journal/save" method="post" id="journal-submit" name="journal-submit">


    <input type="hidden" name="created_by" value={ strconv.FormatInt(journal.CreatedBy, 10) } />
    if journal.ID != nil {
    <input type="hidden" name="id" value={ strconv.FormatInt(*journal.ID, 10) } />
    }
    <div class="row mb-3">
      <div class="col-md-4">

        <input type="date" id="journal-date" name="journal-date" class="form-control" required value={
          journal.JournalDate.Format("2006-01-02") } />
      </div>
      <div class="col-md-4">

        if journal.JournalNumber != nil {
        <input type="text" id="journal-number" name="journal-number" readonly class="form-control"
          value={*journal.JournalNumber } />
        }else{
        <input placeholder="Journal Number" type="text" id="journal-number" name="journal-number"
          class="form-control" />
        }
      </div>
      {}

    </div>
    <div class="row mb-3 align-items-center">

      <div class="col-md-12">
        <input placeholder="Summary Description" type="text" name="description" id="description" class="form-control"
          required value={ journal.Description } />
      </div>
    </div>
    <table class="table table-bordered table-primary" id="journal-lines">
      <thead class="primary">
        <tr>
          <th style="width: 25%;">Account</th>
          <th style="width: 35%;">Description</th>
          <th style="width: 20%;">Debit</th>
          <th style="width: 20%;">Credit</th>
        </tr>
      </thead>
      <tbody id="tbody">
        if len(journal.Lines) == 0 {
        <tr>
          <td>
            <select name="accounts_id[]" class="form-select account" aria-label="Default select example">
              <option value="">Select Account</option>
              for _, account := range accounts {
              <option value={ strconv.FormatInt(account.Id, 10) }>{ account.AccountCode } - { account.AccountName }
              </option>
              }
            </select>
          </td>
          <td><input type="text" name="line_description[]" class="form-control description" required /></td>
          <td><input type="number" name="debit[]" class="form-control debit" /></td>
          <td><input type="number" name="credit[]" class="form-control credit" /></td>
        </tr>

        } else {
        for _, item := range journal.Lines {
        <tr>
          <td>
            <select name="accounts_id[]" class="form-select account" aria-label="Default select example">
              <option value="">Select Account</option>
              for _, account := range accounts {
              if account.Id == item.AccountID {
              <option selected value={ strconv.FormatInt(account.Id, 10) }>{ account.AccountCode } - {
                account.AccountName }
              </option>

              }else{
              <option value={ strconv.FormatInt(account.Id, 10) }>{ account.AccountCode } - { account.AccountName }
              </option>
              }
              }
            </select>
          </td>
          <td><input type="text" name="line_description[]" class="form-control description" required value={
              item.Description } />
          </td>
          <td><input type="number" step="0.00" name="debit[]" class="form-control debit" value={
              item.Debit.StringFixed(2) } /></td>
          <td>
            <input type="number" name="credit[]" class="form-control credit" value={ item.Credit.StringFixed(2) } />
          </td>

        </tr>
        }

        }
        <tr id="balance-row" class="table-primary">
          <td></td>
          <td class="text-primary" style="padding: 17px;"><strong>Balance</strong></td>
          <td><input type="number" name="debit-bal" class="form-control" readonly value="0.00" tabindex="-1" /></td>
          <td><input type="number" name="credit-bal" class="form-control" readonly value="0.00" tabindex="-1" /></td>
        </tr>
      </tbody>
    </table>
    <span class="text-danger">{ msg }</span>
    if journal.Status != "closed" {
    <div class="mb-3 p-3 border">

      <div class="row text-center">
        if journal.ID != nil {
        <div class="col-md-6" id="post-status">
          <button id="post-button" type="button" class="btn btn-success w-50" data-bs-toggle="modal"
            data-bs-target="#postJournalModal">
            Post
          </button>
        </div>
        }
        <div class="col-md-6">
          <button type="button" id="add-line" class="btn btn-primary w-50">Add Line</button>
        </div>
        <div class="col-md-6 d-none" id="save-status">
          <button type="submit" class="btn btn-success w-50">Save</button>
        </div>
      </div>

    </div>
    }
  </form>

</div>
if journal.Status == "closed" {
<div class="row text-center">
  <div class="col-md-12">
    <a href="/journal/list/pending" class="btn btn-primary w-50">Journal List <i
        class="bi bi-arrow-return-left"></i></a>
  </div>
</div>
}
<form action="/journal/post" method="post" id="journal-post" name="journal-post">
  if journal.ID != nil {
  <input type="hidden" name="id" value={ strconv.FormatInt(*journal.ID, 10) } />
  }
</form>


<!-- Modal -->
<div class="modal fade" id="postJournalModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Confirm Posting</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        Are you sure you want to post this journal?
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirmPostBtn">
          Post Journal
        </button>
      </div>

    </div>
  </div>
</div>

<!-- The actual form -->
if journal.ID != nil {
<form id="journal-post" action="/journal/post" method="post">
  <input type="hidden" name="id" value={*journal.ID} />
</form>
}
}