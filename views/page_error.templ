package views
import "gl/messages"



templ ErrorPage(msg messages.Message){

<div>
    <div class="d-flex align-items-center justify-content-center min-vh-100 px-2">
        <div class="text-center">
            <h1 class="display-1 fw-bold text-danger">{ msg.ErrorType }</h1>
            <p class="fs-2 fw-medium mt-4">{ msg.ErrorHeader }</p>
            <p class="mt-4 mb-5">{ msg.ErrorMessage }</p>
            <a href={ msg.Redirect } class="btn btn-danger fw-semibold rounded-pill px-4 py-2 custom-btn">
                Go Home
            </a>
        </div>
    </div>
</div>
}