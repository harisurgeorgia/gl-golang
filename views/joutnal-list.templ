package views

import (
"gl/models"
"strconv"
)

templ JournalList(journals []models.Journal) {
<div class="container mt-5">
    <table class="table table-striped table-hover">
        <tr>
            <th>Journal Date</th>
            <th>Reference</th>
            <th>Description</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>

        for _, journal := range journals {
        <tr>
            <td>{ journal.JournalDate.Format("2006-01-02") }</td>
            <td>{ *journal.JournalNumber }</td>
            <td>{ journal.Description }</td>
            <td>{ journal.Status }</td>
            <td>
                <a href={ templ.SafeURL("/journal/edit/" + strconv.FormatInt(*journal.ID, 10)) }
                    class="btn btn-primary">
                    <i class="bi bi-eye-fill"></i>
                </a>
            </td>
        </tr>
        }
    </table>

    if len(journals) == 0 {
    <p>No journals found.</p>
    }
</div>
}